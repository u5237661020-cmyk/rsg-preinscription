# Seul index.php est accessible depuis le web : config, lib/, vendor/,
# schema.sql, assets/ restent privés.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "index.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "index.php">
    Allow from all
  </Files>
</IfModule>

# Transmet l'en-tête Authorization à PHP (nécessaire avec PHP-FPM/CGI)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
